{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/backend/src/server.js",
    "test": "node --env-file-if-exists=.env --import tsx --test tests/*.test.ts",
    "seed": "node --env-file=.env --import tsx src/seed.ts",
    "create:admin": "node --env-file=.env --import tsx src/create-admin.ts"
  },
  "dependencies": {
    "@vercel/blob": "^2.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "mongodb": "^7.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
