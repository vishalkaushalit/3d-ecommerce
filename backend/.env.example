MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/garuda_store
# Optional comma-separated origins for separately hosted apps. Same-origin HTTPS is allowed.
# Local development allows localhost, 127.0.0.1, and [::1] on any port automatically.
ALLOWED_ORIGINS=
# Paste the read-write token from your public Vercel Blob store. Used only for uploads.
BLOB_READ_WRITE_TOKEN=
